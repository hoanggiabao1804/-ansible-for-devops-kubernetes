---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: frontend
  namespace: {{ microservice_namespace }}
spec:
  ingressClassName: {{ ingress_class_name }}
  rules:
    - host: {{ ingress_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend
                port:
                  number: 80
